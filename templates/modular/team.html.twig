{% extends 'modular/base.html.twig' %}

{% block module_content %}
{% set columns = page.header.columns|default(3) %}

<div class="team-section">
    {% for category in page.header.team_categories %}
        <div class="team-category mb-10">
            <div class="mb-4 text-center">
                <h3 class="team-category__title">{{ category.category_title }}</h3>
                <p class="team-category__desc">{{ category.category_desc }}</p>
            </div>

            <div class="grid-x grid-padding-x small-up-1 medium-up-2 large-up-3 align-center">
                {% for person in category.members %}
                    <div class="cell display-flex align-center small-12 medium-6 large-{{ 12 / columns }} mb-2">
                        <div class="team-card">
                            <div class="team-card__image-wrapper">
                                {% set image = page.media[person.image] %}
                                {% if image %}
                                    {{ image.cropZoom(400,400).html(person.name, person.name, 'team-card__img')|raw }}
                                {% else %}
                     .team-section {
    padding: 2rem 0;

    .team-card {
        background: #fff;
        border: 1px solid #e6e6e6;
        border-radius: 8px;
        padding: 1.5rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start; // Keeps content left-aligned inside the card

        &__image-wrapper {
            width: 100%; 
            // max-width: 70%; // Fluid scale without dominating the whole card
            margin-bottom: 1.25rem;
            border-radius: 4px;
            overflow: hidden;
            flex-shrink: 0;

            // Ensures a strict 1:1 aspect ratio
            aspect-ratio: 1 / 1; 
            
            .team-card__placeholder {
                background-color: #eeeeee;
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
            }
        }

        &__img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        &__content {
            width: 100%;
        }

        &__name {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: #222;
        }

        &__bio {
            font-size: 0.85rem;
            line-height: 1.5;
            color: #666;
            margin: 0;
        }
    }
}               <div class="team-card__placeholder"></div>
                                {% endif %}
                            </div>
                            <div class="team-card__content">
                                <h5 class="team-card__name">{{ person.name }}</h5>
                                <p class="team-card__bio">{{ person.bio }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}