{% import "partials/macros.html.twig" as helpers %}

{% extends "default.html.twig" %}

{% set size = 300 %}

{% block content %}

{% if page.collection('events')|length > 0 %}

<div class="grid-container news-listing mb-7">

    <div class="h2 text-center">
        {{ 'THEME_CCL.UPCOMING_EVENTS'|t }}
    </div>

    {% include "partials/event-list.html.twig" with {
        collection: page.collection('events')
    } %}

</div>

{% endif %}


<div class="grid-container news-listing">

    <div class="grid-x grid-margin-x">

        <div class="cell">

            <div class="h2 text-center">
                {{ 'THEME_CCL.NEWS'|t }}
            </div>


            {% set news = page.collection()|first %}
            {% set category = news.taxonomy.news_category|first|default('other') %}
            {% set category_color = site.cat_color_map[category]|default('secondary') %}


            <div class="media-object stack-for-small align-middle bg-grey-light">

                <div class="media-object-section">
                    <a href="{{ news.url }}">
                        {{ helpers.news_image(news, size, "") }}
                    </a>
                </div>


                <div class="media-object-section pl-1 pr-1">

                    <div class="tag mb-2 bg-{{ category_color }}">
                        {{ ('THEME_CCL.CATEGORY.' ~ category)|t }}
                    </div>

                    <h3 class="mb-2 title">
                        {{ news.title|raw }}
                    </h3>

                    <div>
                        {{ news.header.subheader ? : news.summary(200)|markdown|raw }}
                    </div>

                    <a href="{{ news.url }}" class="button">
                        {{ 'THEME_CCL.READ_MORE'|t }}
                    </a>

                </div>

            </div>

        </div>

    </div>


    <div class="grid-x grid-margin-x">


        {# <div class="cell medium-4 large-3 mt-4">

            <h2>
                {{ 'THEME_CCL.CATEGORIES'|t }}
            </h2>


            <div class="category-list">

                <a href="{{ page.url }}" class="text-secondary">
                    {{ 'THEME_CCL.ALL'|t }} ({{ page.children|length }})
                </a>
                <br>

                {% set news_categories = taxonomy.taxonomy['news_category'] %}


                {% if news_categories %}

                    {% for category in news_categories %}

                        {% set cat = category|first|first %}

                        <a href="{{ page.url }}/news_category:{{ cat }}"
                           class="text-secondary">

                            {{ ('THEME_CCL.CATEGORY.' ~ cat)|t }}
                            ({{ taxonomy.findTaxonomy({'news_category':cat})|length }})

                        </a>

                    {% endfor %}

                {% endif %}

            </div>

        </div> #}

        <div class="cell medium-4 large-3 mt-4">
            <h2>
                {{ 'THEME_CCL.CATEGORIES'|t }}
            </h2>

            <div class="category-list">
                {# Fix: Use page.collection()|length so the count matches the active total collection #}
                {% set total_news = page.collection()|length %}
                <a href="{{ page.url }}" class="text-secondary">
                    {{ 'THEME_CCL.ALL'|t }} ({{ total_news }})
                </a>
                <br>

                {% set news_categories = taxonomy.taxonomy['news_category'] %}

                {% if news_categories %}
                    {% for cat, pages in news_categories %}
                        <a href="{{ page.url }}/news_category:{{ cat }}" class="text-secondary">
                            {{ ('THEME_CCL.CATEGORY.' ~ cat)|t }}
                            ({{ pages|length }})
                        </a>
                        <br>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <div class="cell medium-8 large-9">

            <div class="grid-x grid-margin-x">


                {% for news in page.collection() %}

                    {% set category = news.taxonomy.news_category|first|default('other') %}
                    {% set category_color = site.cat_color_map[category]|default('secondary') %}


                    <div class="cell medium-4 mt-4 bg-grey-light">

                        <a href="{{ news.url }}">


                            {{ helpers.news_image(
                                news,
                                size,
                                "img news-item-border-" ~ category_color
                            ) }}


                            <div class="tag mb-2 ml-1 mr-1 bg-{{ category_color }}">

                                {{ ('THEME_CCL.CATEGORY.' ~ category)|t }}

                            </div>


                            <div class="ml-1 mr-1">

                                <h5 class="title">
                                    {{ news.header.hero_title|default(news.title)|raw }}
                                </h5>

                            </div>


                        </a>

                    </div>


                {% endfor %}


            </div>

        </div>


    </div>


</div>

{% endblock %}