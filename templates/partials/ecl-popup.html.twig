
{% for popup in config.site.ecl_popups %}
    {% if popup.active == '1' %}
        <div class="reveal middle ecl-announcement-modal" 
             id="modal-{{ popup.id }}" 
             data-reveal 
             data-close-on-click="false"
             data-popup-id="{{ popup.id }}"
             data-expiry="{{ popup.deadline|date("Y/m/d H:i") }}"
             data-cooldown="{{ popup.cooldown }}">
             
            <div class="modal-content text-center">
                {{ popup.content|raw }}

                {# Unified Date display if deadline exists #}
                {% if popup.deadline %}
                <div class="callout secondary" style="margin-top: 2rem;">
                    <h5> {{ popup.limit_text }}</h5>
                    <p class="h4"><strong>{{ popup.deadline|date("d F Y")|replace({'January': 'janvier', 'February': 'février', 'March': 'mars', 'April': 'avril', 'May': 'mai', 'June': 'juin', 'July': 'juillet', 'August': 'août', 'September': 'septembre', 'October': 'octobre', 'November': 'novembre', 'December': 'décembre'}) }}</strong></p>
                </div>
                {% endif %}

                <div class="checkbox-container grid-x align-center-middle">
                    <input id="ack-{{ popup.id }}" type="checkbox" class="popup-ack-check" style="width: auto; margin-right: 15px; transform: scale(1.5);">
                    <label for="ack-{{ popup.id }}" style="cursor: pointer; font-weight: bold;">J'ai compris</label>
                </div>

                <div class="modal-footer" style="min-height: 50px;">
                    <button class="button success hidden shadow close-ecl-modal" data-close type="button">Continuer</button>
                </div>
            </div>
        </div>
    {% endif %}
{% endfor %}

<style>
.ecl-announcement-modal { min-height: 60vh; padding: 2rem !important; border-radius: 12px; border: none; box-shadow: 0 10px 50px rgba(0,0,0,0.3); max-width: 600px; }
.hidden { display: none !important; }
.checkbox-container { margin: 1.5rem 0; font-size: 1.1rem; }
#modal-footer .button { font-weight: bold; padding: 1rem 2rem; border-radius: 5px; }
</style>