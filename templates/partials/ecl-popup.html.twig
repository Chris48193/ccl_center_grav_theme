{# We find the home page specifically to access its 'ecl_exam' header data #}
{% set home_page = page.find('/') %}
{% set exam_data = home_page.header.ecl_exam %}

{# Check if active and we are on the homepage #}
{% if exam_data.active == '1' and page.home %}
<div class="reveal large ecl-announcement-modal" 
     id="eclExamModal" 
     data-reveal 
     data-close-on-click="false" 
     data-active="{{ exam_data.active }}"
     {# Restored this line so your JS can find the date #}
     data-exam-date="{{ exam_data.deadline|date("Y-m-d H:i") }}">
     
    <div class="modal-content text-center">
        <h2 class="text-secondary">🚨 {{ exam_data.session }}</h2>
        <hr>
        
        <div class="lead">
            {{ exam_data.custom_text|raw }}
        </div>
        
        <div class="callout secondary" style="margin-top: 2rem;">
            <h5>Date limite d'inscription :</h5>
            <p class="h4">
                <strong>
                    {% set dt = exam_data.deadline|date("d F Y") %}
                    {# Manual translation for French months #}
                    {{ dt|replace({
                        'January': 'janvier', 'February': 'février', 'March': 'mars', 
                        'April': 'avril', 'May': 'mai', 'June': 'juin', 
                        'July': 'juillet', 'August': 'août', 'September': 'septembre', 
                        'October': 'octobre', 'November': 'novembre', 'December': 'décembre'
                    }) }}
                </strong>
            </p>
        </div>

        <div class="checkbox-container grid-x align-center-middle">
            <input id="ack-check" type="checkbox" style="width: auto; margin-right: 15px; transform: scale(1.5);">
            <label for="ack-check" style="cursor: pointer; font-weight: bold;">J'ai compris, je souhaite accéder au site</label>
        </div>

        <div id="modal-footer" style="min-height: 50px;">
            <button class="button success hidden shadow" id="close-ecl-modal" data-close type="button">
                Continuer vers le site
            </button>
        </div>
    </div>
</div>

<style>
.ecl-announcement-modal { min-height: 60vh; padding: 2rem !important; border-radius: 12px; border: none; box-shadow: 0 10px 50px rgba(0,0,0,0.3); max-width: 600px; }
.hidden { display: none !important; }
.checkbox-container { margin: 1.5rem 0; font-size: 1.1rem; }
#modal-footer .button { font-weight: bold; padding: 1rem 2rem; border-radius: 5px; }
.modal-content .lead { line-height: 1.6; }
</style>
{% endif %}