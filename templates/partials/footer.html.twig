{# templates/partials/footer.html.twig #}
<footer class="footer mt-10 text-center large-text-left">
  <div class="grid-container mt-8 mb-8">
    {# Top Row: Logo & Contact Info #}
    <div class="grid-x grid-padding-x align-justify footer__top">
      <div class="cell small-12 medium-4 footer__brand">
        <a class="head-nav__home" href="{{ home_url }}">
            {{ page.media["theme://images/logo.png"].html(site.title ~ " logo", site.title ~ " logo", "footer__logo")|raw }}
        </a>
        <p class="footer__description mb-0">
          {{ 'THEME_ECL.FOOTER.DEFAULT_DESCRIPTION'|t|default(site.metadata.description) }}
        </p>
      </div>

      <div class="cell small-12 medium-5 footer__contact mt-5 md-mt-0 lg-pt-2">
        {% if site.contact.address or 'THEME_ECL.SITE.ADDRESS'|t != 'THEME_ECL.SITE.ADDRESS' %}
        <div class="contact-item">
          <i class="fas fa-map-marker-alt icon"></i>
          <p>{{ 'THEME_ECL.SITE.ADDRESS'|t|default(site.contact.address)|nl2br }}</p>
        </div>
        {% endif %}
        
        {% if site.contact.whatsapp %}
        <div class="contact-item">
          <i class="fab fa-whatsapp icon"></i>
          <p><a href="https://wa.me/{{ site.contact.whatsapp|replace({'+': '', ' ': ''}) }}" target="_blank" rel="noopener">{{ site.contact.whatsapp }}</a></p>
        </div>
        {% endif %}

        {% if site.contact.email %}
        <div class="contact-item">
          <i class="far fa-envelope icon"></i>
          <p><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  <hr class="footer__divider">

  <div class="grid-container mt-8 mb-8">
    {# Middle Row: Quick Links & Socials #}
    <div class="grid-x grid-padding-x footer__middle">
      <div class="grid-x cell small-12 medium-5 align-justify">
        <div class="cell small-6 medium-6">
          <h5>{{ 'THEME_ECL.FOOTER.QUICK_LINKS'|t }}</h5>
          <ul class="vertical menu">
            <li><a href="{{ base_url_relative }}/">{{ 'THEME_ECL.FOOTER.HOME'|t }}</a></li>
            <li><a href="{{ base_url_relative }}/a-propos-de-ccl-center">{{ 'THEME_ECL.FOOTER.ABOUT'|t }}</a></li>
            <li><a href="{{ site.links.registration|default('https://exam.eclexam.eu/?id=P69NL7') }}" target="_blank" rel="noopener">{{ 'THEME_ECL.FOOTER.REGISTRATION'|t }}</a></li>
          </ul>
        </div>

        <div class="cell small-6 medium-6">
          <h5>{{ 'THEME_ECL.FOOTER.RESOURCES'|t }}</h5>
          <ul class="vertical menu">
            <li><a href="https://eclexam.eu/deutsch/mustertests/" target="_blank" rel="noopener">{{ 'THEME_ECL.FOOTER.PREPARATION'|t }}</a></li>
            <li><a href="https://eclexam.eu/deutsch/mustertests/" target="_blank" rel="noopener">{{ 'THEME_ECL.FOOTER.SAMPLE_TESTS'|t }}</a></li>
            <li><a href="https://eclexam.eu/deutsch/prufungsergebnisse/" target="_blank" rel="noopener">{{ 'THEME_ECL.FOOTER.RESULTS_INFO'|t }}</a></li>
          </ul>
        </div>
      </div>

      <div class="cell small-12 medium-4 medium-offset-2 footer__socials">
        <h5>{{ 'THEME_ECL.FOOTER.FOLLOW_US'|t }}</h5>
        <div class="social-icons">
          {% if site.social.facebook %}
            <a href="{{ site.social.facebook }}" target="_blank" class="social-icon" rel="nofollow noopener noreferrer"><img src="{{ url('theme://images/icons/facebook.png') }}" alt="Facebook"></a>
          {% endif %}
          {% if site.social.tiktok %}
            <a href="{{ site.social.tiktok }}" target="_blank" class="social-icon" rel="nofollow noopener noreferrer"><img src="{{ url('theme://images/icons/tiktok.png') }}" alt="TikTok"></a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {# Bottom Row: Copyright #}
  <div class="footer__bottom">
    <div class="grid-container">
      <div class="grid-x align-justify">
        <div class="cell shrink">© {{ "now"|date("Y") }} {{ site.title|default('CCL-Center') }}. {{ 'THEME_ECL.FOOTER.ALL_RIGHTS_RESERVED'|t }}</div>
        <div class="cell shrink"><a href="{{ base_url_relative }}/politique-de-confidentialite">{{ 'THEME_ECL.FOOTER.PRIVACY_POLICY'|t }}</a></div>
      </div>
    </div>
  </div>
</footer>