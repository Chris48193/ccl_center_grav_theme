{% if config.plugins.langswitcher.enabled %}
  {% set current_lang = langswitcher.current ?? grav.language.getLanguage() %}
  {% set display_format = config.get('plugins.langswitcher.language_display', 'short') %}

  <a href="#" class="head-nav__link head-nav__lang-trigger">
    <i class="fa-solid fa-globe"></i>
    <span>{{ current_lang|upper }}</span>
  </a>

  <ul class="head-nav__submenu head-nav__lang-dropdown">
    {% for language in langswitcher.languages %}
      {% if language != current_lang %}
        {% set show_language = true %}
        
        {# 1. Calculate correct route with session-reset prefix support #}
        {% set switcher_route = langswitcher.switcher_routes[language] ?? langswitcher.translated_routes[language] %}
        {% if switcher_route %}
          {% set lang_url = switcher_route ~ page.urlExtension %}
        {% else %}
          {% set base_lang_url = base_url_simple ~ grav.language.getLanguageURLPrefix(language) %}
          {% set lang_url = base_lang_url ~ langswitcher.page_route ~ page.urlExtension %}
        {% endif %}

        {# 2. Respect untranslated pages behavior set in plugin settings #}
        {% set untranslated_pages_behavior = config.get('plugins.langswitcher.untranslated_pages_behavior', 'none') %}
        {% if untranslated_pages_behavior != 'none' %}
          {% set translated_page = langswitcher.translated_pages[language] %}
          {% if (not translated_page) or (not translated_page.published) %}
            {% if untranslated_pages_behavior == 'redirect' %}
              {% set lang_url = url('/') %}
            {% elseif untranslated_pages_behavior == 'hide' %}
              {% set show_language = false %}
            {% endif %}
          {% endif %}
        {% endif %}

        {% if show_language %}
          {% set full_url = lang_url ~ uri.params ~ (uri.query|length > 1 ? '?' ~ uri.query : '') %}
          <li>
            <a href="{{ full_url }}">
              {% if display_format == 'short' %}
                {{ language|upper }}
              {% else %}
                {{ native_name(language)|capitalize }}
              {% endif %}
            </a>
          </li>
        {% endif %}

      {% endif %}
    {% endfor %}
  </ul>
{% endif %}