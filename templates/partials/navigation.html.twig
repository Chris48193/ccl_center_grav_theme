{% import _self as self %}
{% set user = grav.user %}

<div class="grid-container">
    {# Added align-justify so logo stays far-left and controls stay far-right #}
    <nav class="head-nav grid-x align-middle align-justify" role="navigation">

        {# --- LEFT: LOGO --- #}
        <div class="cell auto large-shrink logo-container">
            <a class="head-nav__home" href="{{ base_url == "" ? "/" : base_url }}">
                {{ page.media["theme://images/logo.svg"].html(site.title ~ " logo", site.title ~ " logo", "head-nav__logo")|raw }}
                {{ page.media["theme://images/logo-dark.svg"].html(site.title ~ " logo", site.title ~ " logo", "head-nav__logo logo-dark")|raw }}
            </a>
        </div>

        {# --- MOBILE ONLY CONTROLS (Langswitcher + Sandwich Toggle) --- #}
        <div class="cell shrink hide-for-large head-nav__mobile-controls">
            
            {# Direct Mobile Langswitcher #}
            {% if config.plugins.langswitcher.enabled %}
                <div class="head-nav__item--langswitcher head-nav__item--langswitcher-mobile">
                    {% include 'partials/langswitcher.html.twig' %}
                </div>
            {% endif %}

            {# Sandwich / Close Toggle Button #}
            <button class="head-nav__menu-toggle" type="button" data-toggle="responsive-menu" aria-label="Toggle Navigation">
                <span class="head-nav__hamburger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </button>
        </div>

        {# --- DESKTOP & EXPANDED MOBILE MENU --- #}
        <div class="cell small-12 large-auto">
            <div id="responsive-menu" class="navigation-line show-for-large" data-toggler="show-for-large">
                
                {# Nav links list only #}
                <ul class="head-nav__menu menu vertical large-horizontal nowrap" data-responsive-menu="accordion large-dropdown">
                    {{ self.loop(pages, 1) }}
                </ul>

                {# Actions container: Langswitcher + CTA Button grouped together on Desktop #}
                <div class="head-nav__actions show-for-large">
                    {% if config.plugins.langswitcher.enabled %}
                        <div class="head-nav__item--langswitcher">
                            {% include 'partials/langswitcher.html.twig' %}
                        </div>
                    {% endif %}

                    <div class="head-nav__button-wrapper">
                        {% include 'partials/button.html.twig' with {
                            'url': 'https://ecl.ccl-center.com',
                            'text': 'THEME_CCL.ECL_EXAM'|t,
                            'icon': 'fa fa-external-link-alt',
                            'classes': "btn-small head-nav__register-button",
                            'outline': true
                        } %}
                    </div>
                </div>

            </div>
        </div>

    </nav>
</div>

{% macro loop(page, levels = 2) %}
    {% import _self as self %}
    {% for p in page.children.visible %}
        {% set active = p.active or p.activeChild %}
        {% set children = p.children.visible.count > 0 %}
        {% set recurse = children and levels > 0 and p.header.children_visible|defined(true) %}
        {% set classes = ["head-nav__item"] %}

        {% if active %}
            {% set classes = classes|merge(["head-nav__item--active"]) %}
        {% endif %}

        {% if recurse %}
            {% set classes = classes|merge(["head-nav__item--has-submenu"])%}
        {% endif %}

        <li class="{{ implode(" ", classes) }}">
            <a href="{{ p.routable ? p.url : "#" }}" class="head-nav__link {{ active ? "head-nav__link--active" : "" }}">
                {{ p.menu }}
            </a>

            {% if recurse %}
                <ul class="head-nav__submenu">
                    {{ self.loop(p, levels - 1) }}
                </ul>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}